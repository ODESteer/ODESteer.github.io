                  <td>Log-density ratio (logistic regression)</td>
                </tr>
                <tr>
                  <th scope="row">Output Optimization</th>
                  <td>&ndash;</td>
                  <td>Scoring function with threshold</td>
                </tr>
              </tbody>
            </table>
          </p>
        </div>
