---
// Algorithm.astro - Displays information about the BODES algorithm framework
// import { Fragment } from 'astro/jsx-runtime'

// Predefined math formula variables
const mathFormulas = {
  rawActivation: "$\\boldsymbol{a}$",
  updatedActivation: "$\\tilde{\\boldsymbol{a}}$",
  a0: "$\\boldsymbol{a}(0)$",
  aT: "$\\boldsymbol{a}(T)$",
  setC: "$\\mathcal{C}$",
  timeStep: "$T$",
  velocityField: "$\\boldsymbol{v}(\\boldsymbol{a})$",
  barrierFunction: "$h(\\boldsymbol{a})$",
  barriercdot: "$h(\\cdot)$",
  barrierderive: "$$\\nabla h(\\boldsymbol{a})^\\top \\cdot \\boldsymbol{v}(\\boldsymbol{a}) \\geq 0, \\quad \\forall \\boldsymbol{a} \\in \\mathcal{A},$$",
  barrierFuncDefn: "$h(\\boldsymbol{a}): \\mathbb{R}^d \\rightarrow \\mathbb{R}$",
  goodRegion: "$\\mathcal{C}=\\{ \\boldsymbol{a} \\in \\mathbb{R}^d \\mid h(\\boldsymbol{a}) > 0 \\}$",
  activationAddition: "$$\\tilde{\\boldsymbol{a}} = \\boldsymbol{a} + T \\cdot \\boldsymbol{v}(\\boldsymbol{a}),$$",
  inlineode: "$\\dot{\\boldsymbol{a}} = \\boldsymbol{v}(\\boldsymbol{a})$",
  ode: "$$\\dot{\\boldsymbol{a}} = \\boldsymbol{v}(\\boldsymbol{a}) \\quad \\Longrightarrow \\quad \\boldsymbol{a}(T) = \\boldsymbol{a}(0) + T \\cdot \\boldsymbol{v}(\\boldsymbol{a}(0)),$$",
  ourBarrierFunction: "$$h(\\boldsymbol{a}) = \\log r(\\boldsymbol{a}) = \\log \\frac{p_+(\\boldsymbol{a})}{p_-(\\boldsymbol{a})} = \\boldsymbol{w}^\\top \\boldsymbol{\\phi}(\\boldsymbol{a}) + b,$$",
  w: "$\\boldsymbol{w}$",
  phi: "$\\boldsymbol{\\phi}(\\cdot)$",
  b: "$b$",
  ourODE: "$$\\dot{\\boldsymbol{a}} = \\frac{\\nabla h(\\boldsymbol{a})}{\\|{\\nabla h(\\boldsymbol{a})}\\|} = \\frac{\\boldsymbol{J}_{\\boldsymbol{\\phi}}(\\boldsymbol{a})^\\top \\boldsymbol{w}}{\\|{\\boldsymbol{J}_{\\boldsymbol{\\phi}}(\\boldsymbol{a})^\\top \\boldsymbol{w}}\\|},$$",
  Jphi: "$\\boldsymbol{J}_{\\boldsymbol{\\phi}}(\\boldsymbol{a})$",
  solveode: "$$\\tilde{\\boldsymbol{a}} = \\boldsymbol{a}(T) = \\mathrm{ODESolve}(\\boldsymbol{v}(\\cdot), \\boldsymbol{a}, [0, T]).$$",
}

// @ts-ignore
---
<section id="starpo" class="content-section">
  <div class="section-container">
    <h2 class="section-title" id="tldr">TL;DR</h2>

    <div class="abstract-content">
      <p>
        <li>
          We propose a <strong>unified theoretical framework for activation steering</strong> in LLM alignment via ordinary differential equations (ODEs), interpreting the <em>activation addition</em> as numerically solving an ODE and the steering direction identification as defining a barrier function from control theory.
        </li>
        <li>
          Building on this framework, we introduce <strong>ODESteer</strong>, a novel method that performs <em>multi-step and adaptive</em> activation updates by solving an ODE guided by the barrier function.
        </li>
        <li>
          Compared to SOTA activation steering methods, <strong>ODESteer</strong> achieves consistent empirical improvements on diverse LLM alignment benchmarks, a notable <strong>5.7%</strong> improvement over TruthfulQA, <strong>2.5%</strong> over UltraFeedback, and <strong>2.4%</strong> over RealToxicityPrompts.
        </li>
      </p>
    </div>

    <h2 class="section-title" id="framework" style="margin-top: 5rem;">Unified ODE-Based Steering Framework</h2>
    
